{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upsie Partner Network Authorization Repair Notes API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Repair Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Repair Notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.upsie.com/partner/repairnotes",
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Get All Repair Notes"
        },
        {
          "info": {
            "name": "Create Repair Note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.upsie.com/partner/repairnotes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Create Repair Note"
        }
      ]
    }
  ],
  "bundled": true
}