      "items": [
        {
          "info": {
            "name": "Get All Repairs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.upsie.com/partner/repairs",
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint returns all repairs regardless of any given status or attriibute. Filtering can be done client side or via query params. Documentation of the query param syntax used by the Upsie Repair Network API can be found below. Examples are included in the request Params tab. Please note that these params serve as examples only. They will not return any results unless matching data has been created for this organization. In order to test the included query params, create data such that the q"
        },
        {
          "info": {
            "name": "Create a Repair (all-in-one example)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.upsie.com/partner/repairs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "token",
              "value": "{{token}}",
              "placement": "header"
            }
          },
          "docs": "Create a Repair (all-in-one example)"
        },
        {
